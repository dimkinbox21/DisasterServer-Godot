# Generated by tools/export_server_simulation.py; edit the client source.
extends "res://src/simulation/generated/survivors/base.gd"
## Tails: flight, charged tail shot, recoil, animation and ability HUD.
const TAILS_ACC := 0.046875
const TAILS_MAXSPEED := 11
const TAILS_FLY := 14  # BALANCING+1 in the original
const TAILS_ATTACK1 := 15  # BALANCING+2
const TAILS_ZIPLINE := 16
const TAILS_FLY_RECHARGE := -420
const TAILS_FLY_TIME := 160
const TAILS_ATTACK_RECHARGE := 23 * 60
const ETAILS_ATTACK_RECHARGE := 12 * 60
const TAILS_CHARGE_MAX := 60 * 3.5


func setup() -> void:
	super.setup()
	p.flyTimer = TAILS_FLY_RECHARGE


func reset_abilities() -> void:
	super.reset_abilities()
	p.flyTimer = TAILS_FLY_RECHARGE
	p.isFlying = false


func spring() -> void:
	if p.isFlying:
		p.isFlying = false
		p.flyTimer = 0


func before_hurt_state() -> int:
	return TAILS_ATTACK1 if p.attackCharge > 0 or p.attackAfter > 0 else -1


func after_hurt_state() -> int:
	return TAILS_FLY if p.isFlying else -1


func animation_speed() -> bool:
	match p.state:
		TAILS_FLY:
			p.image_speed = 2
		TAILS_ZIPLINE:
			p.image_speed = 0
			p.image_index = 0
		TAILS_ATTACK1:
			pass
		p.FALL:
			p.image_speed = 0
			p.image_index = 1 if p.yspd > 0 else 0
		_:
			return super.animation_speed()
	return true


func draw_abilities(_unused = null):
	pass


func special() -> void:
	# red ring / hiding soft-lock the abilities (the original pins the timers)
	if p.redRingTimer > 0:
		if p.attackTimer <= 2:
			p.attackTimer = 2
		if p.flyTimer <= TAILS_FLY_RECHARGE + 2:
			p.flyTimer = TAILS_FLY_RECHARGE + 2
	if p.isHiding:
		if p.attackTimer <= 2 * 60:
			p.attackTimer = 2 * 60
		if p.flyTimer <= TAILS_FLY_RECHARGE + 2 * 60:
			p.flyTimer = TAILS_FLY_RECHARGE + 2 * 60

	# the tail can be checked without the fly taking over the jump)
	if (
		Globals.playerControls
		and not p.isGrounded
		and p.kp(Globals.KeyA)
		and p.attackCharge <= 0
		and p.attackAfter <= 0
	):
		if not p.isFlying and p.flyTimer <= TAILS_FLY_RECHARGE:
			GameAudio.play_sound("snd_tails_fly")
			p.flyTimer = TAILS_FLY_TIME
			p.isFlying = true
		if p.isFlying:
			if p.flyTimer > 0:
				p.flyGrv = -1.0
			else:
				p.isFlying = false
			p.isJumping = false
			if absf(p.xspd) > 0:
				p.image_xscale = signf(p.xspd)

	if p.isFlying:
		p.isSpinning = false
		if p.flyGrv < 2.0:
			p.flyGrv += 0.035
		if p.flyTimer <= 0:
			p.isFlying = false
		p.yspd = p.flyGrv

	if p.flyTimer > 0 and p.flyTimer % 18 == 0:
		GameAudio.play_sound("snd_tails_fly")

	if Globals.playerControls and p.kp(Globals.KeyB) and p.attackTimer == 0 and p.attackCharge == 0:
		GameAudio.play_sound("snd_tails_charge")
		p.attackTimer = ETAILS_ATTACK_RECHARGE if p.revivalTimes >= 2 else TAILS_ATTACK_RECHARGE
		p.attackCharge = 1

	if p.attackCharge > 0:
		p.emotion = false
		p.attackTimer = ETAILS_ATTACK_RECHARGE if p.revivalTimes >= 2 else TAILS_ATTACK_RECHARGE
		p.attackCharge += 1
		p.isJumping = false
		p.isFlying = false
		p.xspd = 0.0
		p.gspd = 0.0
		p.canMove = false
		if p.kd(Globals.KeyLeft):
			p.image_xscale = -1.0
		elif p.kd(Globals.KeyRight):
			p.image_xscale = 1.0
		p.attackKDir = p.image_xscale
		if (
			p.attackCharge >= TAILS_CHARGE_MAX
			or not Globals.playerControls
			or p.isZipline
			or p.isHurt
			or p.isDead
			or p.shockedTimer > 0
			or not p.kd(Globals.KeyB)
		):
			GameAudio.stop_sound("snd_tails_charge")
			var val := floorf((p.attackCharge / 60.0) / 3.5 * 100.0)
			var tier := int(ceili(val / 20.0))
			if p.revivalTimes >= 2:
				# demon: the shot itself hurts (1/2/3 sections by charge)
				var dmg := 1
				if p.attackCharge >= 84 and p.attackCharge < 126:
					dmg = 2
				if p.attackCharge >= 126:
					dmg = 3
				_spawn_projectile(dmg, true, tier)
			else:
				_spawn_projectile(1 + int(floorf(p.attackCharge / 42.0)), false, tier)
			p.camera_shake(25, 1.2, 0.1)
			GameAudio.play_sound("snd_tails_shoot")
			if p.attackCharge < 84:
				p.attackAfter = int(60 * 0.4)
				p.recoil = -p.attackKDir * 2.0
			elif p.attackCharge < 126:
				p.attackAfter = int(60 * 0.5)
				p.recoil = -p.attackKDir * 4.0
			else:
				p.attackAfter = int(60 * 0.6)
				p.recoil = -p.attackKDir * 6.0
		if p.isHurt or p.hp <= 0 or p.isDead or p.shockedTimer > 0 or p.isZipline:
			p.isJumping = false
			p.isFlying = false
			p.isSpinning = false
			p.canMove = true
			p.attackCharge = 0
			p.attackAfter = 0

	# the original's tail of scr_tails_special: timer ticks + recoil decay
	if p.attackAfter <= 0:
		p.canSpin = true
	else:
		p.recoil -= minf(absf(p.recoil), p.acc * 3.0) * signf(p.recoil)

	if p.attackTimer > 0:
		p.attackTimer -= 1

	if p.isGrounded:
		if p.isFlying:
			p.isFlying = false
			p.flyTimer = 0
		if p.flyTimer > TAILS_FLY_RECHARGE:
			p.flyTimer -= 1
	elif p.flyTimer > 0:
		p.flyTimer -= 1

	if p.attackAfter > 0:
		if p.isHurt or p.hp <= 0 or p.isDead or p.shockedTimer > 0 or p.isZipline:
			p.isJumping = false
			p.isFlying = false
			p.isSpinning = false
			p.canMove = true
			p.attackAfter = 0
			p.attackCharge = 0
		p.canSpin = false
		p.attackAfter -= 1
		p.attackCharge = 0
		p.isJumping = false
		p.isFlying = false
		p.isSpinning = false
		p.canMove = true
		p.xspd = p.recoil
		p.gspd = p.recoil


func _spawn_projectile(dmg: int, is_exe: bool, charge_tier: int) -> void:
	if Net.state == Net.STATE_GAME:
		var b := Net.cpacket_tcp(Net.PacketType.CLIENT_TPROJECTILE)
		b.put_u16(int(p.position.x))
		b.put_u16(int(p.position.y))
		b.put_8(int(p.image_xscale))
		b.put_u8(dmg)
		b.put_u8(1 if is_exe else 0)
		b.put_u8(charge_tier)
		Net.send_server_tcp(b)
		return
	var projectile := SimulationNode.new()
	projectile.set_script(load("res://src/simulation/generated/obj_tails_projectile.gd"))
	projectile.position = p.position
	projectile.image_xscale = p.image_xscale
	projectile.set("dmg", dmg)
	projectile.set("is_exe", is_exe)
	projectile.set("charge", charge_tier)
	projectile.set("is_owner", true)
	p.get_parent().add_child(projectile)


