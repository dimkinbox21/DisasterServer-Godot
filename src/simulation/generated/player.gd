func _near_refresh() -> void:
	_near_r.clear()
	_near_simple.clear()
	_near_one_way.clear()
	for f in _near:
		_near_r.append(f.cached_bbox())
		_near_simple.append(f._mask_simple)
		_near_one_way.append(f.is_in_group("gm_jumpthrough"))
	# NOTE: clear() keeps capacity — no per-frame allocation


func near_inst(x: float, y: float) -> SimulationFloor:
	for i in _near.size():
		var r: Rect2 = _near_r[i]
		if (
			x >= r.position.x
			and x < r.end.x
			and y >= r.position.y
			and y < r.end.y
			and _near[i].point_in_mask(x, y)
		):
			return _near[i]
	return null


## scr_collision_check walks: first solid pixel within maxd steps of x at row y.
## Unrotated full-frame masks (all spr_block solids) are resolved analytically —
## only rotated/masked floors do the pixel walk.
func near_inst_left(x: float, y: float, maxd: int) -> SimulationFloor:
	var best := maxd + 1
	var bf: SimulationFloor = null
	for i in _near.size():
		if _near_one_way[i]:
			continue
		var r: Rect2 = _near_r[i]
		if y < r.position.y or y >= r.end.y or r.position.x > x or r.end.x - 1.0 < x - maxd:
			continue
		if _near_simple[i]:
			var d := int(x - minf(x, r.end.x - 1.0))
			if d < best:
				best = d
				bf = _near[i]
		else:
			var f: SimulationFloor = _near[i]
			var cx := x
			var d2 := 0
			while d2 <= maxd:
				if f.point_in_mask(cx, y):
					if d2 < best:
						best = d2
						bf = f
					break
				cx -= 1
				d2 += 1
	return bf


func near_inst_right(x: float, y: float, maxd: int) -> SimulationFloor:
	var best := maxd + 1
	var bf: SimulationFloor = null
	for i in _near.size():
		if _near_one_way[i]:
			continue
		var r: Rect2 = _near_r[i]
		if y < r.position.y or y >= r.end.y or r.end.x - 1.0 < x or r.position.x > x + maxd:
			continue
		if _near_simple[i]:
			var d := int(maxf(x, r.position.x) - x)
			if d < best:
				best = d
				bf = _near[i]
		else:
			var f: SimulationFloor = _near[i]
			var cx := x
			var d2 := 0
			while d2 <= maxd:
				if f.point_in_mask(cx, y):
					if d2 < best:
						best = d2
						bf = f
					break
				cx += 1
				d2 += 1
	return bf


func pm_near(x: float, y: float) -> bool:
	for i in _near.size():
		var f: SimulationFloor = _near[i]
		var r: Rect2 = _near_r[i] if f.gm_static else f.cached_bbox()
		if (
			x >= r.position.x
			and x < r.end.x
			and y >= r.position.y
			and y < r.end.y
			and f.point_in_mask(x, y)
		):
			return true
	return false


