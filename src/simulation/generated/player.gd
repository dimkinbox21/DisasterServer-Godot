	redRingTimer = 600


func anim_step() -> void:
	if hunter != null:
		hunter.anim_step()
		return
	if isDead:
		state = DEAD
		apply_anim()
		return
	if survivor != null:
		survivor.anim_step()
		return
	if not emotion:
		state = IDLE
	if won and isGrounded:
		state = EXE_WON
		apply_anim()
		return
	if lost and isGrounded:
		state = EXE_LOST
		apply_anim()
		return
	if isHurt:
		state = HURT
		apply_anim()
		return
	if shockedTimer > 0:
		state = HURT if not isGrounded else EXE_SHOCKED
		apply_anim()
		return
	if isAttacking:
		if isGrounded:
			if state == EXE_AIR_ATTACK:
				isAttacking = false
			else:
				state = EXE_ATTACK
		else:
			if state == EXE_ATTACK:
				isAttacking = false
			else:
				state = EXE_AIR_ATTACK
		apply_anim()
		return
	if isZipline:
		if isGrounded:
			isZipline = false
		state = EXE_ZIPLINE
		apply_anim()
		return
	if isLookingUp:
		state = LOOKUP
		apply_anim()
		return
	if isLookingDown:
		state = LOOKDOWN
		apply_anim()
		return
	if isSpinning:
		state = SPIN
		apply_anim()
		return
	if absf(xspd) > 0 and isGrounded:
		state = WALK if absf(xspd) < 8 else RUN
	if isOnEdge:
		state = BALANCING
		apply_anim()
		return
	if not isGrounded:
		state = JUMP if isJumping else FALL
	apply_anim()


func apply_anim() -> void:
	if hunter != null:
		hunter.apply_anim()
		return
	if survivor != null and survivor.reset_animation_on_change and _character_anim_state != state:
		_character_anim_state = state
		image_index = 0
		_anim_accum = 0
	if state != DEAD:
		_dead_pin = false  # re-arm for the next death/shock
	var invis := not _is_survivor() and invisTimer > 0
	var table := anims_invis if invis else anims_cur
	if _is_survivor() and revivalTimes >= 2:
		table = anims_eanims  # obj_tails Draw_76: the demon table
	var idx := state
	if invis and state == HURT:
		idx = WALK
	sprite_name = table[idx]
	if OS.get_environment("ANIMTRACE") == "1" and Engine.get_physics_frames() % 30 == 0:
		print(
			"ANIMTRACE state=",
			state,
			" spr=",
			sprite_name,
			" flying=",
			isFlying,
			" grounded=",
			isGrounded,
			" char=",
			Globals.character
		)
	if survivor != null and survivor.animation_speed():
		return
	match state:
		IDLE:
			image_speed = 1.0
		HURT, EXE_ZIPLINE:
			image_speed = 0.0
			image_index = 0
		DEAD:
			# obj_tails Draw_76: the demon death loops at half speed; a normal
			# death plays once (grounded speed 1, air frozen) and pins on the
			# last frame. My base wraps looping sprites BEFORE this runs, so the
			# pin keeps a done-flag instead of a bare clamp.
			if revivalTimes >= 2:
				image_speed = 0.5
			else:
				image_speed = 1.0 if isGrounded else 0.0
				var cnt := GM.sprite_count(sprite_name)
				if _dead_pin or image_index >= cnt - 1:
					image_index = cnt - 1
					image_speed = 0.0
					_dead_pin = true
		BALANCING:
			image_xscale = edgeDir
			image_speed = 1.0
		FALL:
			image_speed = 0.1
			if image_index >= GM.sprite_count(sprite_name) - 1:
				image_index = GM.sprite_count(sprite_name) - 1
			image_xscale = 1 if xspd > 0 else (-1 if xspd < 0 else image_xscale)
		WALK:
			image_speed = absf(xspd) / maxHSpeed
		RUN, JUMP:
			image_speed = maxf(absf(xspd) / 20.0, 0.5)
		LOOKUP, LOOKDOWN:
			image_speed = 0.2
			if image_index >= 1:
				image_index = 1
		SPIN:
			image_speed = absf(xspd) / 5.0
		EXE_ATTACK:
			image_speed = 2.0
			if image_index >= GM.sprite_count(sprite_name) - 1:
				xspd *= 0.7
				gspd *= 0.7
				isAttacking = false
		EXE_AIR_ATTACK:
			image_speed = 0.8
			if image_index >= GM.sprite_count(sprite_name) - 1:
				xspd *= 0.7
				gspd *= 0.7
				isAttacking = false
				isJumping = false
		EXE_SHOCKED:
			image_speed = 0.5
		EXE_LOST, EXE_WON:
			image_speed = 0.8
		EMOTION1, EMOTION2, EMOTION3:
			image_speed = 0.8


# Other_7 — emotion animation end handling
func _gm_animation_end() -> void:
	anim_special()


func anim_special() -> void:
	if hunter != null:
		hunter.animation_end()
		return
	if survivor != null:
		survivor.animation_end()
		return
	match state:
		IDLE:
			image_index = (
				mini(70, GM.sprite_count(sprite_name) - 1)
				if _is_survivor()
				else maxi(0, GM.sprite_count(sprite_name) - 25)
			)
		EMOTION1:
			if not kd(Globals.KeyEm1):
				image_index = 0
				state = IDLE
				emotion = false
		EMOTION2:
			if not kd(Globals.KeyEm2):
				image_index = 0
				state = IDLE
				emotion = false
		EMOTION3:
			if kd(Globals.KeyEm3):
				if _is_survivor():
					image_index = maxi(0, GM.sprite_count(sprite_name) - 8)
			else:
				image_index = 0
				state = IDLE
				emotion = false


