func _gm_step() -> void:
	Unlockables.apply_local_palette()
	if hunter != null:
		hunter.tick()
	if hunter != null and (Net.gameEnds or isHurt or shockedTimer > 0):
		hunter.incapacitated()
	if Net.gameEnds:
		isAttacking = false
		gspd = 0
		xspd = 0
		collision_basic()
		anim_step()
		return
	if slowTimer > 0:
		slowTimer -= 1
		if slowTimer == 0:
			isSlow = false
			restore_speed()
	if not canMove and hunter != null:
		hunter.special()
	elif not canMove and _is_survivor():
		survivor_special()
	elif shockedTimer <= 0:
		move_basic()
	else:
		if survivor != null:
			survivor.incapacitated()
		isBoosting = false
		isLookingDown = false
		isLookingUp = false
		isAttacking = false
		isJumping = false
		gspd -= minf(absf(gspd), acc) * signf(gspd)
		xspd -= minf(absf(xspd), acc) * signf(xspd)
		shockedTimer -= 1
		hurttime = 60 * 2

	if won or lost:
		gspd = 0
		xspd = 0
		angle = 0

	if hunter != null:
		hunter.before_collision()
	collision_basic()
	if hunter != null:
		hunter.after_collision()

	_bounce_off_players()

	if hurttime > 0:
		hurttime -= 1

	_revival_step()

	image_alpha = 0.5 if (hurttime > 0 or isHiding) else 1.0

	# obj_tails Step_0: redRingTimer ticks per frame (the frenzy is 10 real
	# seconds, shortened by ring pickups) — at 1 the track + overlay stop
	if redRingTimer > 0:
		if redRingTimer == 1:
			GameAudio.crossfade_music("mus_mindfuck", 0.0)
			for rs in SimulationNode.all_of("obj_redring_screen"):
				rs.queue_free()
		redRingTimer -= 1

	# Step_2 — animation state machine (End Step)
	anim_step()

	# Keep fractional simulation coordinates; only drawing is pixel-aligned.


## obj_exe / obj_tails Step_0: each owner applies its own half of a
## ball-on-ball collision; normal movement packets carry the resulting impulse.
func _bounce_off_players() -> void:
	if hunter != null and not hunter.ball_contact_allowed():
		return
	if Net.gameEnds or isDead or hp <= 0 or bounceTimer > 0 or not (isJumping or isSpinning):
		return
	var primary_hunter := Globals.character == Globals.CHARACTER_EXE
	if primary_hunter:
		if invisTimer > 0:
			return
	elif not _is_survivor() or Globals.character in [3, 4, 6] or revivalTimes >= 2 or hurttime > 0:
		return
	for puppet in SimulationNode.all_of("obj_player_puppet"):
		if (
			puppet.pcharacter < 0
			or puppet.isInactive
			or not puppet.visible
			or puppet.isHurt
			or puppet.hp <= 0
		):
			continue
		var hunter: bool = puppet.pcharacter == Globals.CHARACTER_EXE or puppet.revivalTimes >= 2
		if (
			hunter == primary_hunter
			or puppet.pstate not in [JUMP, SPIN]
			or puppet.pcharacter in [3, 4, 6]
		):
			continue
		if not bbox_rect().intersects(puppet.bbox_rect()):
			continue
		var direction: Vector2 = (puppet.position - position).sign()
		player_hurt(0, -direction.x * 3.0, -direction.y * 4.0, "snd_buble", "spr_blood2", true)
		bounceTimer = 6
		if primary_hunter and (isJumping or isSpinning):
			camera_shake(30, 1, 0.15)
		return


# ---------------------------------------------------------------- scr_move_basic
func move_basic() -> void:
	justJumped = false
	isLookingDown = false
	isLookingUp = false

	if isDead:
		# scr_move_basic: death kills the frenzy too (stop the track + overlay)
		if redRingTimer > 0:
			GameAudio.crossfade_music("mus_mindfuck", 0.0)
			for rs in SimulationNode.all_of("obj_redring_screen"):
				rs.queue_free()
			redRingTimer = 0
		emotion = false
		isZipline = false
		isAttacking = false
		isBoosting = false
		isHiding = false
		if survivor != null:
			survivor.incapacitated()
		gspd -= minf(absf(gspd), acc) * signf(gspd)
		xspd -= minf(absf(xspd), acc) * signf(xspd)
		xspd -= 0.225 * sin(angle)
		return

	bounceTimer -= 1
	if bounceTimer > 0:
		if isGrounded:
			bounceTimer = -1
	if bounceTimer == 0:
		if _is_survivor():
			isJumping = false
			isSpinning = false
		if isGrounded:
			bounceTimer = -1

	if isHurt:
		if survivor != null:
			survivor.incapacitated()
		isAttacking = false
		gspd = 0
		if xspd > -1 and xspd < 1 and isGrounded:
			isHurt = false
		if xspd > 0:
			xspd -= 0.06
		else:
			xspd += 0.06
		yspd += 0.08
		isBoosting = false
		emotion = false
		return

	if isBoosting:
		if survivor != null:
			survivor.boosting()
		if hunter != null:
			hunter.spring()
		if effectTime <= 0:
			effectTime = 16
		if isGrounded:
			gspd = 12 * image_xscale
			gspd -= 0.125 * sin(angle)
			xspd = gspd * cos(angle)
			yspd = gspd * -sin(angle)
		return

	_update_edge_balance()

	if state != IDLE and state != EMOTION1 and state != EMOTION2 and state != EMOTION3 and emotion:
		emotion = false

	if state == IDLE and kp(Globals.KeyIdle):
		image_index = 53 if Globals.character == 4 else 48

	if Globals.playerControls and not emotion and not isOnEdge:
		if kp(Globals.KeyEm1):
			if state == IDLE and taunt1():
				image_index = 0
				state = EMOTION1
				emotion = true
				if hunter != null:
					hunter.emotion_sound(1)
		elif kp(Globals.KeyEm2):
			if state == IDLE and taunt2():
				image_index = 0
				state = EMOTION2
				emotion = true
				if hunter != null:
					hunter.emotion_sound(2)
		elif kp(Globals.KeyEm3):
			if state == IDLE:
				image_index = 0
				state = EMOTION3
				emotion = true
				if hunter != null:
					hunter.emotion_sound(3)
				else:
					GameAudio.play_emotion3(Globals.character, Globals.exeCharacter)

	move_ground()
	if _is_survivor():
		survivor_special()
	else:
		exe_special()

	if not isGrounded:
		angle = 0
		if Globals.playerControls:
			# scr_move_basic: the same acc * 2 steering in flight and in air.
			var steer := acc * 2.0
			if kd(Globals.KeyLeft):
				image_xscale = -1
				xspd -= steer
			elif kd(Globals.KeyRight):
				image_xscale = 1
				xspd += steer
		if yspd < 0 and yspd > -4:
			if absf(xspd) > 0:
				var d := ceili(xspd / 0.125)
				xspd -= d / 256.0
	else:
		if (
			Globals.playerControls
			and kp(Globals.KeyA)
			and not isJumping
			and (survivor == null or survivor.allows_jump())
		):
			GameAudio.play_sound("snd_jump")
			isGrounded = false
			isSpinning = false
			isJumping = true
			justJumped = true
			image_index = 0
			xspd -= jumpForce * sin(angle)
			yspd = -jumpForce * cos(angle)


## scr_move_basic: inspect below the supported FOOT sensor, toward the
## unsupported side. Wall sensors sit above the floor and misread stairs as pits.
func _update_edge_balance() -> void:
	isOnEdge = false
	if not isGrounded or xspd != 0 or _sens_coll_BL == _sens_coll_BR:
		return
	var sensor := _sens_BL if _sens_coll_BL else _sens_BR
	var offsets := range(8, -8, -1) if _sens_coll_BL else range(-8, 8)
	for i in offsets:
		var supported := false
		for j in 16:
			if pm_near(sensor.x + i, sensor.y + j):
				supported = true
				break
		if not supported:
			isOnEdge = true
			edgeDir = 1 if i >= 0 else -1
			return


func taunt1() -> bool:
	return true


func taunt2() -> bool:
	return true


func move_ground() -> void:
	if isGrounded:
		isJumping = false
		if (
			Globals.playerControls
			and kd(Globals.KeyDown)
			and (hunter == null or hunter.allows_look())
		):
			if gspd == 0:
				isLookingDown = true
				gspd = 0
			elif absf(gspd) >= 2 and not isSpinning and canSpin:
				GameAudio.play_sound("snd_spin")
				isSpinning = true
		if (
			Globals.playerControls
			and kd(Globals.KeyUp)
			and gspd == 0
			and (hunter == null or hunter.allows_look())
		):
			isLookingUp = true
			gspd = 0
		if not isSpinning:
			if not isLookingDown and not isLookingUp:
				if Globals.playerControls and kd(Globals.KeyLeft):
					if gspd < 0:
						image_xscale = -1
					if gspd > 0:
						gspd -= 0.5
						if gspd <= 0:
							gspd = -0.5
					elif gspd > -maxHSpeed:
						gspd -= acc
						if gspd <= -maxHSpeed:
							gspd = -maxHSpeed
				elif Globals.playerControls and kd(Globals.KeyRight):
					if gspd > 0:
						image_xscale = 1
					if gspd < 0:
						gspd += 0.5
						if gspd >= 0:
							gspd = 0.5
					elif gspd < maxHSpeed:
						gspd += acc
						if gspd >= maxHSpeed:
							gspd = maxHSpeed
				else:
					gspd -= minf(absf(gspd), acc) * signf(gspd)
		else:
			if Globals.playerControls and kd(Globals.KeyLeft) and gspd > 0:
				gspd -= 0.125
				if gspd <= 0:
					isSpinning = false
			elif Globals.playerControls and kd(Globals.KeyRight) and gspd < 0:
				gspd += 0.125
				if gspd >= 0:
					isSpinning = false
			gspd -= minf(absf(gspd), 0.0234375) * signf(gspd)

		if not isSpinning:
			gspd -= 0.125 * sin(angle)
			xspd = gspd * cos(angle)
			yspd = gspd * -sin(angle)
		else:
			gspd -= 0.225 * sin(angle)
			xspd = gspd * cos(angle)
			yspd = gspd * -sin(angle)
		if gspd == 0:
			isSpinning = false


## scr_camera_shake — with(obj_camera) { shake = true; ... }
func camera_shake(_time: int, _magnitude: float, _fade := 0.25) -> void:
	pass


func _is_survivor() -> bool:
	return Globals.character != Globals.CHARACTER_EXE and Globals.character >= 0


# ---------------------------------------------------------- survivor interface
func survivor_special() -> void:
	if survivor != null:
		survivor.special()


func restore_speed() -> void:
	if hunter != null:
		hunter.restore_speed()
	elif survivor != null:
		survivor.restore_speed()
	else:
		acc = EXE_ACC
		maxHSpeed = EXE_MAXSPEED


func apply_slow(ticks := 180, factor := 0.6) -> void:
	restore_speed()
	isSlow = true
	slowTimer = ticks
	acc *= factor
	maxHSpeed *= factor


func reset_character_abilities() -> void:
	if survivor != null:
		survivor.reset_abilities()
	else:
		attackTimer = 0


func tails_special() -> void:
	survivor_special()


# ---------------------------------------------------------------- scr_exe_special
func exe_special() -> void:
	if hunter != null:
		hunter.special()
		return
	if won or lost:
		invisTimer = EXE_INVIS_RECHARGE
		isAttacking = false
		attackTimer = 0

	if Globals.playerControls and isJumping and kp(Globals.KeyA):
		isJumping = false

	if Globals.playerControls and kp(Globals.KeyC):
		if invisTimer <= EXE_INVIS_RECHARGE:
			GameAudio.play_sound("snd_exe_invisenter")
			GameAudio.play_sound("snd_exe_appear")
			invisTimer = EXE_INVIS_DURATION
		elif invisTimer > 0:
			invisTimer = 0

	if invisTimer == 0:
		GameAudio.play_sound("snd_exe_appear")

	if invisTimer > EXE_INVIS_RECHARGE:
		invisTimer -= 1

	if Globals.playerControls and kp(Globals.KeyB) and attackTimer <= 0 and invisTimer <= 0:
		if kd(Globals.KeyLeft):
			image_xscale = -1
		elif kd(Globals.KeyRight):
			image_xscale = 1
		image_index = 0
		attackSpeed = xspd
		attackTimer = 60 if isGrounded else 120
		isAttacking = true
		isJumping = false
		isSpinning = false
		GameAudio.play_sound("snd_dash")

	if invisTimer > 0:
		isAttacking = false
		return

	if isAttacking:
		if yspd > 0:
			yspd = 0.0 if isGrounded else 2.5
		if isGrounded and absf(xspd) > 0 and int(floor(position.x)) % 4 == 0:
			quick_effect(position.x - 8 * signf(image_xscale), position.y + 20, "spr_dust")

	if attackTimer > 0:
		attackTimer -= 1


func quick_effect(
	_x: float, _y: float, _spr: String, _fade := true, _direction := 1.0
) -> SimulationNode:
	return Net.effect_node


func collision_basic() -> void:
	xspd = clampf(xspd, -maxHSpeed, maxHSpeed)
	yspd = clampf(yspd, -maxYSpeed, maxYSpeed)
	# A fast wall impact can resolve the body away from a thin damage strip.
	# Keep the swept lower-body query from before collision resolution.
	var boost_hazard: SimulationNode = null
	if isBoosting and Net.lvlId == 7:
		var area := Rect2(
			position + Vector2(-12, minf(yspd, 0)), Vector2(24, 20 + absf(minf(yspd, 0)))
		)
		area = area.merge(Rect2(area.position + Vector2(xspd, 0), area.size))
		boost_hazard = SimulationFloor.rect_meeting_group(area, "obj_damage")

	# fell out of the room → respawn at deathtp_point, snapped onto the
	# nearest floor below it (the original relies on death-respawn here)
	if Net.state != Net.STATE_GAME and position.y - 30 >= fall_limit_y:
		var nearest: SimulationNode = null
		var best := 1e18
		for d in SimulationNode.all_of("obj_deathtp_point"):
			var dist: float = d.position.distance_squared_to(position)
			if dist < best:
				best = dist
				nearest = d
		if nearest:
			position = nearest.position
			xspd = 0
			gspd = 0
			yspd = 0
			# find the first floor below the point and stand on it
			var sx := position.x
			var sy := position.y - 16
			var found := false
			while sy < fall_limit_y + 64:
				if (
					SimulationFloor.point_meeting_floor(sx - 7, sy)
					or SimulationFloor.point_meeting_floor(sx + 7, sy)
				):
					found = true
					break
				sy += 1
			if found:
				position.y = sy - 18
			else:
				# no floor under the point — teleport to the first spawnpoint
				for sp in SimulationNode.all_of("obj_spawnpoint"):
					position = sp.position + Vector2(0, -18)
					break
			player_hurt(1, 0, 0)
			if Globals.character == Globals.CHARACTER_EXE:
				shockedTimer += 30

	if not isGrounded:
		yspd += yAccel

	collision_objects_before()

	# The query buffer is shared; each actor retains its own parallel sensor cache.
	_near.assign(SimulationFloor.gather_near(position.x, position.y, 80))
	_near_refresh()
	collision_check_walls()
	position.x += xspd

	collision_check_top()
	position.y += yspd

	collision_check_bottom()

	collision_objects_after()
	if boost_hazard != null and boost_hazard.gm_name == "obj_damage":
		player_hurt(1, -image_xscale * 4, -6, "snd_spike")


## scr_collision_check — walls
func collision_check_walls() -> void:
	var coll := false
	var yy_end := 0 if isGrounded else int(15 - absf(xspd))
	for yy in range(-16, yy_end):
		var sl := Vector2(ceilf(position.x) - 8, ceilf(position.y + yy))
		var sr := Vector2(ceilf(position.x) + 8, ceilf(position.y + yy))
		# left
		var inst1 := near_inst_left(sl.x, sl.y, maxHSpeed + 1)
		var dist1 := maxHSpeed + 1
		if inst1 != null:
			if inst1._mask_simple:
				dist1 = int(sl.x - minf(sl.x, inst1.cached_bbox().end.x - 1.0))
			else:
				dist1 = 0
				var cx2 := sl.x
				while dist1 <= maxHSpeed + 1 and not inst1.point_in_mask(cx2, sl.y):
					cx2 -= 1
					dist1 += 1
		# right
		var inst2 := near_inst_right(sr.x, sr.y, maxHSpeed + 1)
		var dist2 := maxHSpeed + 1
		if inst2 != null:
			if inst2._mask_simple:
				dist2 = int(maxf(sr.x, inst2.cached_bbox().position.x) - sr.x)
			else:
				dist2 = 0
				var cx3 := sr.x
				while dist2 <= maxHSpeed + 1 and not inst2.point_in_mask(cx3, sr.y):
					cx3 += 1
					dist2 += 1
		_sens_L_x = sl.x
		_sens_L_y = sl.y
		_sens_R_x = sr.x
		_sens_R_y = sr.y

		if -dist1 >= minf(xspd, -1):
			coll = true
			if xspd < 0:
				position.x = ceilf(sl.x) + 8
				xspd = 0
				gspd = 0
				isBoosting = false
				if survivor != null:
					survivor.wall_collision(inst1, -1)
				if hunter != null:
					hunter.wall_collision(inst1, -1)
				break
		if dist2 <= maxf(xspd, 1):
			coll = true
			if xspd > 0:
				position.x = ceilf(sr.x) - 8
				xspd = 0
				gspd = 0
				isBoosting = false
				if survivor != null:
					survivor.wall_collision(inst2, 1)
				if hunter != null:
					hunter.wall_collision(inst2, 1)
				break


## scr_collision_check_top — ceilings
func collision_check_top() -> void:
	var s1 := Vector2(ceilf(position.x) - 7, ceilf(position.y) - 18)
	var s2 := Vector2(ceilf(position.x) + 7, ceilf(position.y) - 18)
	var dist1 := 0
	while not pm_near(s1.x, s1.y) and dist1 < maxYSpeed + 1:
		s1.y -= 1
		dist1 += 1
	var dist2 := 0
	while not pm_near(s2.x, s2.y) and dist2 < maxYSpeed + 1:
		s2.y -= 1
		dist2 += 1

	if dist1 != maxYSpeed + 1 and dist2 != maxYSpeed + 1:
		if s1.y >= s2.y:
			if -dist1 >= yspd and yspd < 0:
				if not SimulationFloor.point_meeting_group(s1.x, s1.y, "gm_jumpthrough"):
					position.y = ceilf(s1.y) + 18
					yspd = 0
		elif s1.y < s2.y:
			if -dist2 >= yspd and yspd < 0:
				if not SimulationFloor.point_meeting_group(s2.x, s2.y, "gm_jumpthrough"):
					position.y = ceilf(s2.y) + 18
					yspd = 0
	elif dist1 != maxYSpeed + 1:
		if -dist1 >= yspd and yspd < 0:
			if not SimulationFloor.point_meeting_group(s1.x, s1.y, "gm_jumpthrough"):
				position.y = ceilf(s1.y) + 18
				yspd = 0
	elif dist2 != maxYSpeed + 1:
		if -dist2 >= yspd and yspd < 0:
			if not SimulationFloor.point_meeting_group(s2.x, s2.y, "gm_jumpthrough"):
				position.y = ceilf(s2.y) + 18
				yspd = 0


## scr_collision_check_bottom — ground snap + angle
func collision_check_bottom() -> void:
	var s1 := Vector2(ceilf(position.x) - 7, 0)
	var s2 := Vector2(ceilf(position.x) + 7, 0)
	# original resets the BOTTOM sensor coll flags here (edge balance reads them)
	_sens_coll_BL = false
	_sens_coll_BR = false

	if not isGrounded:
		angle = 0
		s1.y = ceilf(position.y) - 16
		s2.y = ceilf(position.y) - 16
		var dist1 := 0
		while not pm_near(s1.x, s1.y) and dist1 < 35:
			s1.y += 1
			dist1 += 1
		var dist2 := 0
		while not pm_near(s2.x, s2.y) and dist2 < 35:
			s2.y += 1
			dist2 += 1
		var land := -1
		if dist1 != 35 and dist2 != 35:
			if s1.y < s2.y:
				land = dist2
				if yspd > 0:
					land_on(
						s2.y - 18,
						SimulationFloor.point_meeting_group(s2.x, s2.y, "gm_jumpthrough") != null,
						dist2
					)
			else:
				land = dist1
				if yspd > 0:
					land_on(
						s1.y - 18,
						SimulationFloor.point_meeting_group(s1.x, s1.y, "gm_jumpthrough") != null,
						dist1
					)
		elif dist1 != 35:
			land = dist1
			if yspd > 0:
				land_on(
					s1.y - 18,
					SimulationFloor.point_meeting_group(s1.x, s1.y, "gm_jumpthrough") != null,
					dist1
				)
		elif dist2 != 35:
			land = dist2
			if yspd > 0:
				land_on(
					s2.y - 18,
					SimulationFloor.point_meeting_group(s2.x, s2.y, "gm_jumpthrough") != null,
					dist2
				)
		_sens_coll_BL = land >= 0 and dist1 <= 2
		_sens_coll_BR = land >= 0 and dist2 <= 2
		_sens_BL = s1
		_sens_BR = s2

	if isGrounded:
		s1.y = ceilf(position.y) - 16
		s2.y = ceilf(position.y) - 16
		var maxDist := 48
		if (
			SimulationFloor.point_meeting_group(_sens_L_x, _sens_L_y, "obj_angleallower") != null
			or SimulationFloor.point_meeting_group(_sens_R_x, _sens_R_y, "obj_angleallower") != null
		):
			maxDist = 38
		var _dist1 := 0
		while not pm_near(s1.x, s1.y) and _dist1 < maxDist:
			s1.y += 1
			_dist1 += 1
		var _dist2 := 0
		while not pm_near(s2.x, s2.y) and _dist2 < maxDist:
			s2.y += 1
			_dist2 += 1

		if _dist1 != maxDist or _dist2 != maxDist:
			var winner := 0.0
			if s1.y == s2.y:
				_sens_coll_BL = true
				_sens_coll_BR = true
			if s1.y > s2.y:
				_sens_coll_BR = true
				winner = s2.y - 18
			else:
				_sens_coll_BL = true
				winner = s1.y - 18
			position.y = winner
			collision_check_angle()
		else:
			angle = 0
			isGrounded = false
		_sens_BL = s1
		_sens_BR = s2


func land_on(winner: float, jumpthrough: bool, dist: int) -> void:
	if jumpthrough:
		if yspd > 0 and dist >= 15:
			position.y = winner
			isGrounded = true
			yspd = 0
			gspd = xspd
	else:
		if yspd > 0:
			position.y = winner
			isGrounded = true
			yspd = 0
			gspd = xspd


## scr_collision_check_angle — OWN sweep (sensors x±7 from y-16, maxDist 66);
## angle=0 when either side misses — standing on a corner must NOT slope
func collision_check_angle() -> void:
	var s1 := Vector2(position.x - 7, position.y - 16)
	var s2 := Vector2(position.x + 7, position.y - 16)
	var d1 := 0
	while not pm_near(s1.x, s1.y) and d1 < 66:
		s1.y += 1
		d1 += 1
	var d2 := 0
	while not pm_near(s2.x, s2.y) and d2 < 66:
		s2.y += 1
		d2 += 1
	if d1 != 66 and d2 != 66:
		angle = -deg_to_rad(rad_to_deg(Vector2(-8, d1).angle_to_point(Vector2(8, d2))))
	else:
		angle = 0


## scr_collision_objects_before — nothing map-specific solo
func collision_objects_before() -> void:
	Net.before_player(self)


func collision_objects_after() -> void:
	if isDead:
		return
	var feet := Vector2(position.x, position.y)
	# springs — original checks the BOTTOM sensors (BL then BR)
	var spring := SimulationFloor.point_meeting_group(_sens_BL.x, _sens_BL.y, "obj_spring_parent")
	if spring == null:
		spring = SimulationFloor.point_meeting_group(_sens_BR.x, _sens_BR.y, "obj_spring_parent")
	if spring and spring.image_blend == GM.C_WHITE and yspd > 0 and shockedTimer <= 0:
		if isHurt:
			isHurt = false
		if isAttacking and Globals.character == Globals.CHARACTER_EXE:
			attackTimer = 60 if isGrounded else 120
			isAttacking = false
		if survivor != null:
			survivor.spring()
		if hunter != null:
			hunter.spring()
		xspd = spring.xdir
		yspd = (
			(-12 if kd(Globals.KeyA) or kd(Globals.KeyUp) else -10)
			if spring.hold_sensitive
			else spring.ydir
		)
		isBoosting = false
		isSpinning = false
		isGrounded = false
		isJumping = false
		spring.spring_hit()
		if Net.state == Net.STATE_GAME and Net.lvlId == 0 and revivalTimes < 2 and not Net.gameEnds:
			Net.report_spring_use(position)

	# damage rects
	var hazard := SimulationFloor.rect_meeting_group(
		Rect2(position + Vector2(-12, yspd), Vector2(24, maxf(0, 20 - yspd))), "obj_damage"
	)
	if hazard != null and hazard.gm_name == "obj_damage":
		angle = 0
		player_hurt(1, -image_xscale * 4, -6, "snd_spike")
	var dmg_rect := Rect2(position.x - 6, position.y + 19, 12, 1)
	var dmg := SimulationFloor.rect_meeting_group(dmg_rect, "obj_damage")
	if dmg is SimulationNode and dmg.gm_name == "obj_spike":
		# original: collision_rectangle(x-6, y+19, x+6, y+20, obj_spike) →
		# hurt(20, -image_xscale*4, -6, snd_spike). The solid sprite mask means
		# the feet only ever reach the rect standing ON TOP; a side approach is
		# blocked by the wall before the rect can overlap.
		angle = 0
		player_hurt(1, -image_xscale * 4, -6, "snd_spike")
	elif dmg is SimulationNode and dmg.gm_name == "obj_movingspike":
		# standing ON the spikes = damage; brushing them sideways while running
		# (feet below the mask top, the lifted mask) = no damage
		if dmg.image_index > 0 and dmg.image_index < 5:
			var mr: Rect2 = dmg.bbox_rect()
			if (
				position.y + 18.0 >= mr.position.y - 1.0
				and position.y + 18.0 <= mr.position.y + 3.0
			):
				angle = 0
				player_hurt(1, -image_xscale * 4, -6, "snd_spike")
	# angleanullers
	if (
		SimulationFloor.point_meeting_group(_sens_L_x, _sens_L_y, "obj_angleanuller")
		or SimulationFloor.point_meeting_group(_sens_R_x, _sens_R_y, "obj_angleanuller")
		or SimulationFloor.point_meeting_group(_sens_L_x, _sens_L_y, "obj_angleanuller_eggsafe")
		or SimulationFloor.point_meeting_group(_sens_R_x, _sens_R_y, "obj_angleanuller_eggsafe")
	):
		angle = 0
	# ladders slow the player
	for lad in SimulationNode.all_of("obj_ladder"):
		if lad.position_meeting(_sens_L_x, _sens_L_y):
			if absf(xspd) > 7:
				xspd = 7 * signf(xspd)
				gspd = 7 * signf(gspd)
			maxHSpeed = 7
	# hiding
	var hide := SimulationFloor.rect_meeting_group(bbox_rect(), "obj_hiding_parent") != null
	isHiding = hide and isLookingDown and not isLookingUp and not isSliding
	if Globals.character not in [0, 6] and revivalTimes < 2 and hurttime <= 0:
		for effect in SimulationNode.all_of("obj_quickeffect"):
			if (
				effect.sprite_name == "spr_shieldbreak2"
				and bbox_rect().intersects(effect.bbox_rect())
			):
				player_hurt(1, -image_xscale * 3, -6, "snd_hurt", "spr_blood1", true)
				break
	if isHiding:
		for camera in SimulationNode.all_of("obj_camera"):
			camera.look_timer = 0


## scr_player_hurt (solo)
## scr_player_hurt port — the order matters and is the original's exactly:
##   1. hp -= damage (survivors only, and not while demonized) — a ring does NOT
##      restore it, it is consumed afterwards for the ringlose feedback
##   2. hp <= 0 -> scr_player_instakill (death), return
##   3. rings > 0 -> rings = 0 + snd_ringlose (+ camera shake), else the hurt sound
func apply_parry(push: float, ticks: int) -> void:
	var predicted := isHurt and hurttime > 0 and not isAttacking
	if survivor != null:
		survivor.incapacitated()
	isAttacking = false
	isHurt = true
	shockedTimer = 0
	hurttime = ticks
	xspd = push
	yspd = -2
	isGrounded = false
	if not predicted:
		GameAudio.play_sound("snd_buble")


func player_hurt(
	damage: int,
	xpw := 4.0,
	ypw := -6.0,
	snd_id := "snd_hurt",
	blood := "spr_blood1",
	network_hit := false,
	server_confirmed := false
) -> void:
	if Net.state == Net.STATE_GAME and not server_confirmed and damage > 0:
		return
	if Net.gameEnds or isDead or (hurttime > 0 and damage > 0 and not server_confirmed):
		return
	if not server_confirmed and damage > 0 and survivor != null and survivor.absorb_damage():
		return
	var was_survivor := _is_survivor() and revivalTimes < 2
	if was_survivor and damage > 0 and Net.state != Net.STATE_GAME:
		hp -= damage
		if hp <= 0:
			player_instakill(server_confirmed)
			return
	if rings > 0 and damage > 0:
		if Net.state != Net.STATE_GAME:
			rings = 0
		GameAudio.play_sound("snd_ringlose")
		quick_effect(position.x, position.y - 10, "spr_ringlose")
		camera_shake(25, 1, 0.2)
	elif damage > 0 or snd_id == "snd_buble":
		GameAudio.play_sound(snd_id)
		camera_shake(25, 1, 0.2)
	if damage > 0:
		quick_effect(position.x, position.y, blood, false, -1.0 if xpw < 0 else 1.0)
		isHurt = true
		isJumping = false
	isGrounded = false
	isSpinning = false
	isLookingDown = false
	isLookingUp = false
	xspd = xpw
	yspd = ypw
	# the original: 1s of invulnerability in the first minute of a round, else 3s
	if damage != 0:
		hurttime = 60 if (Globals.timeMinutes <= 0 and Globals.timeSeconds < 60) else 60 * 3
	else:
		hurttime = 0


## scr_player_instakill — solo emulation of the server-driven death: the client
## reports it, the server ticks the dead timer and answers with the revival
## (revivalTimes = 1, hp 2) or the demonization (revivalTimes = 2, hp 5)
func player_instakill(server_confirmed := false) -> void:
	if Net.state == Net.STATE_GAME and not server_confirmed:
		return
	if Net.gameEnds or isDead:
		return
	hp = 0
	server_death = Net.state == Net.STATE_GAME
	deadTimer = 31
	deadColor = Color.WHITE
	isDead = true
	_dead_pin = false
	image_index = 0
	isHurt = false
	shards = 0
	xspd = image_xscale * 2.0
	Globals.cameraMode = 3
	isGrounded = false
	isSpinning = false
	isLookingDown = false
	isLookingUp = false
	GameAudio.play_sound("snd_dead")
	quick_effect(position.x, position.y, "spr_blood2", false)
	_dead_timer = 60 * 31  # the original's deadTimer = 31 SECONDS (the hud shows them)


## solo revival/demonization (SERVER_GAME_DEATHTIMER_END + SERVER_REVIVAL_REVIVED)
func _revival_step() -> void:
	if Net.state == Net.STATE_GAME:
		return
	if not isDead or _dead_timer <= 0:
		return
	if server_death:
		return  # netplay: the server's TICK/REVIVED/END packets drive this death
	_dead_timer -= 1
	deadTimer = int(ceili(_dead_timer / 60.0))  # the display counts SECONDS
	if _dead_timer > 0:
		return
	if revivalTimes >= 1:
		# second death: demonized — join the hunters
		hp = 5
		isDead = false
		revivalTimes = 2
		hurttime = 60 * 2
		reset_character_abilities()
		GameAudio.play_sound("snd_demonization")
	else:
		# first death: stay down until the next death phase
		hp = 0
		revivalTimes = 1
		deadTimer = 31
		_dead_timer = 1860


var _dead_timer := 60 * 31  # frames — the original's deadTimer starts at 31 SECONDS
var _dead_pin := false  # the DEAD anim reached its last frame (Draw_76 clamp)
## netplay: the SERVER owns this death (DEATHTIMER_TICK/REVIVED/END drive it) —
## the local countdown stands down so revival isn't applied twice
var server_death := false


## the heal: 10 rings -> 1 section (net_state_game ring packet: the check fires on
## EVERY ring gain while rings >= 10 && hp < 5 && _canHeal, and zeroes the
## rings — repeatable, the next heal needs 10 collected again)
func try_heal() -> void:
	if Net.state == Net.STATE_GAME:
		return
	if not _is_survivor() or revivalTimes >= 2 or isDead:
		return
	if rings >= 10 and hp < 5:
		rings = 0
		hp = mini(5, hp + 1)
		GameAudio.play_sound("snd_heal")
		quick_effect(position.x, position.y - 10, "spr_heal_part")


## ring pickup (obj_ring Step_0, survivor branch) — rings += n, then the heal check
func ring_collected(count := 1) -> void:
	if Net.state == Net.STATE_GAME:
		return
	rings += count
	GameAudio.play_sound("snd_ring")
	quick_effect(position.x, position.y, "spr_ring_sparkle")
	# SERVER_RING_COLLECTED: during the frenzy (redRingTimer >= 60) every ring
	# shortens it — 0.5s, or 2s in the round's last minute — down to 1s
	if redRingTimer >= 60:
		var cnt := (2.0 if (Globals.timeMinutes <= 0 and Globals.timeSeconds < 60) else 0.5) * 60
		redRingTimer = int(maxf(redRingTimer - cnt, 60))
	try_heal()


## CLIENT_RING_COLLECTED (_redRing) / the vase path — the red ring frenzy:
## snd_redring + mus_mindfuck + obj_redring_screen + redRingTimer = 60*10s
